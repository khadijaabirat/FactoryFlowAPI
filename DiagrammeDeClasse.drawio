        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class User {\n        +ObjectId _id\n        +String name\n        +String email\n        +String password\n        +Role role\n        +Date createdAt\n    }\n\n    class Role {\n        &lt;&lt;enumeration&gt;&gt;\n        ADMIN\n        OPERATOR\n    }\n\n    class Material {\n        +ObjectId _id\n        +String reference\n        +String name\n        +String unit\n        +Number availableQuantity\n        +Number alertThreshold\n        +Date createdAt\n    }\n\n    class Product {\n        +ObjectId _id\n        +String reference\n        +String name\n        +Date createdAt\n    }\n\n    class CompositionItem {\n        +ObjectId materialId\n        +Number quantity\n    }\n\n    class ManufacturingOrder {\n        +ObjectId _id\n        +ObjectId assignedTo\n        +OrderStatus status\n        +Date startedAt\n        +Date endedAt\n        +Date createdAt\n    }\n\n    class OrderStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        PLANIFIE\n        EN_COURS\n        TERMINE\n        ANNULE\n    }\n\n    class OrderItem {\n        +ObjectId _id\n        +ObjectId productId\n        +Number quantity\n    }\n\n    class OrderSnapshotItem {\n        +ObjectId materialId\n        +String reference\n        +String name\n        +String unit\n        +Number quantityPerUnit\n    }\n\n    class StockMovement {\n        +ObjectId _id\n        +ObjectId materialId\n        +MovementType type\n        +Number quantity\n        +String reason\n        +ObjectId orderId\n        +ObjectId performedBy\n        +Date createdAt\n    }\n\n    class MovementType {\n        &lt;&lt;enumeration&gt;&gt;\n        IN\n        OUT\n    }\n\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; ManufacturingOrder : assigne a\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; StockMovement : effectue par\n    ManufacturingOrder \&quot;0..1\&quot; --&gt; \&quot;*\&quot; StockMovement : genere si OUT\n    Material \&quot;1\&quot; --&gt; \&quot;*\&quot; StockMovement : concerne\n    OrderItem \&quot;*\&quot; --&gt; \&quot;1\&quot; Product : lie au produit\n\n    Product \&quot;1\&quot; *-- \&quot;*\&quot; CompositionItem : contient composition\n    ManufacturingOrder \&quot;1\&quot; *-- \&quot;*\&quot; OrderItem : contient items\n    OrderItem \&quot;1\&quot; *-- \&quot;*\&quot; OrderSnapshotItem : conserve snapshot\n\n    User --&gt; Role : possede\n    ManufacturingOrder --&gt; OrderStatus : utilise\n    StockMovement --&gt; MovementType : utilise&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="RuMY9GrtuMehr6pjPfZm-530">
