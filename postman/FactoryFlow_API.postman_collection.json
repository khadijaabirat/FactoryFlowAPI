    {
      "name": "2. Authentification & Profil (FA-33)",
      "item": [
        {
          "name": "Connexion (Login) -> Auto-sauvegarde du Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.token || (json.data && json.data.token);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('token', token);",
                  "        console.log('Token JWT sauvegardé avec succès:', token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@factoryflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Consulter mon profil (GET /api/auth/profile)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
